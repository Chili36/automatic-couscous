{
  "apps": [
    {
      "name": "foodex2-backend",
      "script": "./server/index.js",
      "cwd": ".",
      "instances": 1,
      "exec_mode": "fork",
      "autorestart": true,
      "watch": ["server"],
      "ignore_watch": ["node_modules", "logs", "data/*.db"],
      "watch_delay": 1000,
      "max_memory_restart": "1G",
      "env": {
        "NODE_ENV": "development",
        "PORT": 5001
      },
      "error_file": "./logs/backend-error.log",
      "out_file": "./logs/backend-out.log",
      "merge_logs": true,
      "time": true
    },
    {
      "name": "foodex2-frontend",
      "script": "npx",
      "args": "vite --port 5178",
      "cwd": "./client",
      "instances": 1,
      "exec_mode": "fork",
      "autorestart": true,
      "watch": ["client/src"],
      "ignore_watch": ["node_modules", "logs"],
      "watch_delay": 1000,
      "max_memory_restart": "500M",
      "env": {
        "NODE_ENV": "development"
      },
      "error_file": "../logs/frontend-error.log",
      "out_file": "../logs/frontend-out.log",
      "merge_logs": true,
      "time": true
    }
  ]
}