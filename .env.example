# FoodEx2 Code Validator Environment Configuration
# Copy this file to .env and update with your specific values

# Server Configuration
NODE_ENV=development
PORT=5001

# Database Configuration
DATABASE_PATH=./data/mtx.db
DATABASE_VERSION=MTX v16.3

# Frontend Configuration
VITE_PORT=5178
VITE_API_URL=http://localhost:5001

# Logging Configuration
LOG_LEVEL=info
LOG_DIR=./logs
LOG_MAX_SIZE=10m
LOG_MAX_FILES=14d

# CORS Configuration
CORS_ORIGIN=http://localhost:5178

# API Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload Settings
MAX_FILE_SIZE=10MB
UPLOAD_DIR=./uploads

# Session Configuration (optional)
SESSION_SECRET=your-secret-key-here
SESSION_TIMEOUT=3600000

# PM2 Configuration (for production)
PM2_INSTANCES=1
PM2_MAX_MEMORY_RESTART=1G

# External Services (if applicable)
# EFSA_API_KEY=your-api-key-here
# EFSA_API_URL=https://api.efsa.europa.eu

# Monitoring (optional)
# SENTRY_DSN=your-sentry-dsn-here
# NEW_RELIC_LICENSE_KEY=your-license-key-here

# Feature Flags
ENABLE_SOFT_RULES=true
ENABLE_FACET_INTERPRETATION=true
ENABLE_BATCH_PROCESSING=true
ENABLE_EXCEL_EXPORT=true

# Performance Settings
MAX_BATCH_SIZE=1000
WORKER_THREADS=4
CACHE_TTL=3600

# Development Settings
DEBUG_MODE=false
VERBOSE_LOGGING=false