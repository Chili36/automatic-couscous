{
  "name": "foodex2-validator",
  "version": "2.0.0",
  "description": "FoodEx2 code validation server with complete ICT implementation",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "setup-db": "node server/setup-database.js",
    "test": "node test/test-validation.js",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:start:json": "pm2 start pm2.json",
    "pm2:stop": "pm2 stop foodex2-backend foodex2-frontend",
    "pm2:restart": "pm2 restart foodex2-backend foodex2-frontend",
    "pm2:reload": "pm2 reload ecosystem.config.js",
    "pm2:delete": "pm2 delete foodex2-backend foodex2-frontend",
    "pm2:logs": "pm2 logs",
    "pm2:logs:backend": "pm2 logs foodex2-backend",
    "pm2:logs:frontend": "pm2 logs foodex2-frontend",
    "pm2:status": "pm2 status",
    "pm2:monit": "pm2 monit"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "csv-parse": "^5.5.2",
    "cors": "^2.8.5",
    "morgan": "^1.10.0",
    "xlsx": "^0.18.5",
    "multer": "^1.4.5-lts.1",
    "json2csv": "^5.0.7"
  },
  "devDependencies": {
    "nodemon": "^3.0.1"
  }
}